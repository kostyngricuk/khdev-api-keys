NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://khdev:khdev@localhost:5432/khdev_keys

# Mailpit (docker compose) catches every email: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="KHDev API Keys <no-reply@khdev.by>"
SUPPORT_EMAIL=support@khdev.by

DASHBOARD_URL=http://localhost:3000
DOCS_URL=http://localhost:3002
WELCOME_VIDEO_URL=https://www.youtube.com/@khdev

# Required in production (min 16 chars)
SERVICE_TOKEN=dev-service-token-change-me
AUTH_CODE_PEPPER=dev-pepper-change-me-please

KEY_TERM_DAYS=365
UPLOAD_DIR=./uploads

# Outside NODE_ENV=production, admin@khdev.by and customer@khdev.by can sign in with the code 123456.
# Always run deployed servers with NODE_ENV=production.
