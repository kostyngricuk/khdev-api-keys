{
  "name": "khdev-keys",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @khdev/api db:generate",
    "db:migrate": "pnpm --filter @khdev/api db:migrate",
    "db:seed:dev": "pnpm --filter @khdev/api db:seed:dev"
  },
  "devDependencies": {
    "turbo": "^2.11.4",
    "typescript": "~6.0.3"
  }
}
